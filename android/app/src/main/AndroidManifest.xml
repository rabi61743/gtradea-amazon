<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Product imagery is fetched over the network. Flutter injects this
         into the debug and profile manifests automatically, but a release
         build would ship without it and every image would fail. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13 and above will not show a notification without this, and
         asks the shopper for it the first time one is posted. Declared only;
         it is requested when the notifications screen is opened, never at
         launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Both, and fine is the one that matters. The address form fills a
         street and house number, not just a town, and coarse alone returns a
         network fix good to a kilometre or three, which is how "use my
         current location" came to drop a pin in the wrong neighbourhood.
         Android still requires coarse to be declared alongside fine, and
         declaring both is what lets the system dialog offer Precise. It is
         asked for only when the button is tapped, never at launch. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Voice search. Requested at the moment the microphone is tapped, never
         at launch, and the audio only ever reaches the platform recogniser. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Visual search. Requested at the moment the camera is chosen, never at
         launch. The gallery needs no permission: image_picker goes through the
         system photo picker, which hands back only the one file the shopper
         chose. -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- The shop's name, not the package name. The label was "gtradea_amazon",
         the identifier `flutter create` writes, and it is what Android shows
         as the app name in the notification header, the app switcher, the
         launcher and the Settings list. The name used here is the one
         BrandWordmark.name already carries. -->
    <application
        android:label="GtradeA"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Package visibility for the speech recogniser. Without these,
             Android 11 and later hide it from this app entirely and voice
             search reports "not available" on a phone that has one. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH"/>
        </intent>
    </queries>
</manifest>
