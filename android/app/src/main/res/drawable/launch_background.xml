<?xml version="1.0" encoding="utf-8"?>
<!--
  The pre API 21 fallback. The drawable-v21 variant beside this one is what
  actually runs on every device this app supports; this exists so the two
  cannot drift apart into different launch experiences.

  The colour is stated literally here because this variant cannot rely on the
  theme attribute the v21 one reads. It is AppColors.backgroundLight.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#F3F2F2" />
    </item>
    <item
        android:drawable="@drawable/splash_logo"
        android:gravity="center" />
</layer-list>
