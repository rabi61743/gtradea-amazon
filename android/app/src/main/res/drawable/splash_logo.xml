<?xml version="1.0" encoding="utf-8"?>
<!--
  The GtradeA mark for the launch window, drawn as vector.

  The three paths are assets/brand/logo.svg, unchanged, in the order that file
  states them. That file's own note explains what was already taken out of the
  storefront's artwork: the white rounded rectangle behind the mark, which is
  app icon backing.

  This exists because the launch window first used @mipmap/ic_launcher, and the
  launcher icon keeps that white plate. On the page colour it read as an app
  icon pasted onto the splash rather than as the shop's mark. Vector also means
  one file for every density, and no softening on the largest screens.

  The source viewBox starts at 36.6, 36.2 rather than the origin, so the group
  shifts the paths back by that much and the viewport is the mark's own size.
  The intrinsic width and height below carry the artwork's proportions, 173.6
  by 158.7, so the layer list can centre it without stating a size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="88dp"
    android:viewportWidth="173.6"
    android:viewportHeight="158.7">
    <group
        android:translateX="-36.6"
        android:translateY="-36.2">
        <path
            android:fillColor="#E94724"
            android:pathData="M169.34,126.56v43.61c-13.86,14.04-33,22.72-54.15,22.72-17.96,0-34.47-6.27-47.53-16.76,2.02.17,4.08.26,6.15.26,32.3,0,59.9-20.67,70.89-49.83h24.64Z" />
        <path
            android:fillColor="#267488"
            android:pathData="M208.22,93.95L208.22,192.69L169.34,192.69L169.34,126.56L104.52,126.56L128.57,94L128.6,93.95Z" />
        <path
            android:fillColor="#E94724"
            android:pathData="M169.48,38.16v.45l-10.32,13.98-10.57,14.3-20.02,27.11c-40.36,1.22-72.79,31.59-73.62,69.18-10.22-13.15-16.3-29.73-16.3-47.75,0-40.15,30.19-73.15,68.83-76.89,2.41-.25,4.87-.37,7.36-.37h54.65Z" />
    </group>
</vector>
